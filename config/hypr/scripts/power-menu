#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' \
  'Lock' \
  'Logout' \
  'Suspend' \
  'Reboot' \
  'Shutdown' | rofi -dmenu -i -p 'Power')"

case "$choice" in
  Lock) loginctl lock-session ;;
  Logout) hyprctl dispatch exit ;;
  Suspend) systemctl suspend ;;
  Reboot) systemctl reboot ;;
  Shutdown) systemctl poweroff ;;
  *) exit 0 ;;
esac
