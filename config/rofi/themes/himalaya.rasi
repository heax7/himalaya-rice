/* GENERATED FILE — edit config/myrice/theme.toml and run scripts/apply-theme. */
* {
    bg: #081016E8;
    surface: #101A22DB;
    fg: #E6F0F0FF;
    muted: #8CA5ABFF;
    primary: #74D7C8FF;
    accent: #E6AC53FF;
    border: #74D7C83D;
}

window {
    width: 620px;
    border: 1px;
    border-color: @border;
    border-radius: 16px;
    background-color: @bg;
    padding: 24px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 16px;
}

inputbar {
    padding: 12px 16px;
    border-radius: 12px;
    background-color: @surface;
    children: [prompt, entry];
}

prompt { text-color: @primary; }
entry { placeholder: "Search"; placeholder-color: @muted; text-color: @fg; }
listview { lines: 8; columns: 1; fixed-height: false; spacing: 6px; }
element { padding: 9px 12px; border-radius: 10px; }
element selected { background-color: @primary; }
element-text { text-color: @fg; }
element-text selected { text-color: #081016; }
